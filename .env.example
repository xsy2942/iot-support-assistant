# DeepSeek chat model.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_TRACKING_ID=
DEEPSEEK_MODEL=deepseek-chat

# Bailian / Alibaba Cloud Model Studio, OpenAI-compatible mode.
BAILIAN_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_API_KEY=
BAILIAN_MODEL=qwen-plus
BAILIAN_EMBEDDING_MODEL=text-embedding-v4

# Tavily web search.
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_API_KEY=

# Local ticket service.
TICKET_SERVICE_HOST=127.0.0.1
TICKET_SERVICE_PORT=8000
# Primary ticket database. Fill this to use PostgreSQL.
# Example: postgresql://postgres:postgres@localhost:5432/iot_support_assistant
TICKET_DB_URL=
# SQLite fallback for local tests or when TICKET_DB_URL is empty.
TICKET_DB_PATH=./data/generated/tickets.sqlite3

# Optional short-term memory for guided troubleshooting sessions.
# Example: redis://localhost:6379/0
TROUBLESHOOTING_REDIS_URL=
TROUBLESHOOTING_SESSION_TTL_SECONDS=1800
AGENT_MEMORY_REDIS_URL=
AGENT_MEMORY_TTL_SECONDS=1800

# Evaluation settings.
EVAL_TOP_K=3
EVAL_REPORT_PATH=./reports/eval_report.json
